# Every setting below can also live in a YAML file: see z-auth.example.yaml.
# ConfigSource::standard() reads the file named here and layers these
# variables on top, so a variable set here always overrides the file.
# AUTH_CONFIG_FILE=/etc/z-auth/z-auth.yaml

# ── z-auth (core) — read by z_auth::conf::config::EnvLoader ───────────────
# Generate keys with:  cargo run --example keygen

# Auth service only: Ed25519 signing seed + refresh-token HMAC key (base64).
AUTH_JWT_SIGNING_KEY=
AUTH_REFRESH_SECRET=
# Every service that verifies access tokens (comma-separated during rotation).
AUTH_JWT_VERIFYING_KEYS=

AUTH_JWT_ISSUER=z-auth                  # optional
AUTH_JWT_ACCESS_TTL_SECS=300              # optional – 5 minutes
AUTH_JWT_LEEWAY_SECS=30                   # optional – clock-skew tolerance
AUTH_SESSION_IDLE_TIMEOUT_SECS=1800       # optional – 30 minutes
AUTH_SESSION_ABSOLUTE_TIMEOUT_SECS=28800  # optional – 8 hours
AUTH_SESSION_HISTORY_SIZE=10              # optional – generations kept for reuse detection
AUTH_REFRESH_GRACE_SECS=30                # optional – concurrent-refresh window
AUTH_IP_BINDING=false                     # optional – true: IP change = theft
AUTH_MAX_SESSIONS_PER_USER=5              # optional – 0 = unlimited
AUTH_PASSWORD_MIN_LENGTH=8                # optional
AUTH_PASSWORD_REQUIRE_UPPERCASE=true      # optional
AUTH_PASSWORD_REQUIRE_DIGIT=true          # optional
AUTH_REFRESH_RETRY_MATCH=ip               # optional – any of ip,user_agent,fingerprint: same client retrying
AUTH_AUTHZ_MODE=rbac                      # optional – none | rbac | permissions | combined
AUTH_EXTERNAL_LINK_MAX_AUTH_AGE_SECS=600  # optional – linking needs a session opened this recently
AUTH_EXTERNAL_LINK_CHALLENGE_TTL_SECS=300 # optional – sign-in waiting for the local password

# ── z-auth-cluster (optional) — read by z_auth_cluster::config::ClusterEnvLoader ──
# Only for services that import z-auth-cluster; z-auth itself ignores these.
# AUTH_DEPLOYMENT_MODE=federation          # standalone | shared | federation (Cluster::new: shared if unset)
# AUTH_CLUSTER_SERVICE=orders              # this service = this cluster (default: z-auth)
# AUTH_CLUSTER_SECRET=                     # base64, ≥ 32 bytes, same everywhere
# AUTH_CLUSTER_ADVERTISE_IP=10.0.0.5       # or AUTH_CLUSTER_ADVERTISE_DNS
# AUTH_CLUSTER_ADVERTISE_PORT=7000
# AUTH_CLUSTER_HEARTBEAT_MS=2000           # also how often to call ZAuth::tick
# AUTH_CLUSTER_WARNING_AFTER=1             # missed beats → warning (alias: AUTH_CLUSTER_OFFLINE_AFTER)
# AUTH_CLUSTER_MISSING_AFTER=1             # further missed beats → evicted (alias: AUTH_CLUSTER_REMOVE_AFTER)
# AUTH_CLUSTER_RETIRED_TTL_SECS=1800       # alias: AUTH_CLUSTER_TOMBSTONE_SECS
# AUTH_CLUSTER_MAX_SKEW_SECS=30            # max sent_at vs. local clock difference
# AUTH_CLUSTER_SELF_FENCE=quorum           # quorum | off (default: quorum in federation, off in shared)

# ── Federation mode only ──────────────────────────────────────────────────────
# AUTH_AUTHORITY_SERVICE=ums               # required – the service that owns identity
# AUTH_CLUSTER_SEEDS=ums.internal:7000     # any instance(s); required except on the authority
# AUTH_LINK_RETRY_ATTEMPTS=3
# AUTH_LINK_RETRY_BACKOFF_MS=200
# AUTH_LINK_BREAKER_FAILURES=3
# AUTH_LINK_BREAKER_COOLDOWN_SECS=30
# AUTH_LINK_DEAD_REPROBE_SECS=60
# AUTH_SESSION_DISTRIBUTION=all            # all | on_demand
# AUTH_FORK_WINDOW_MS=5000
# AUTH_FORK_MAX_BENIGN=1
# AUTH_FORK_BUDGET_WINDOW_SECS=3600
# AUTH_FEDERATION_MAX_STALENESS_SECS=0    # 0 = fail-open
# AUTH_FEDERATION_PULL_PAGE_SIZE=500
# AUTH_FEDERATION_PURGE_HORIZON_SECS=604800

# ── z-auth-mfa (optional) — read by z_auth_mfa::config::MfaEnvLoader ────────
# Only for the service that imports z-auth-mfa (the authority in federation
# mode).  Generate the keys with:  cargo run -p z-auth-mfa --example mfa_keygen
# AUTH_MFA_ENFORCEMENT=optional            # off | optional | required | roles
# AUTH_MFA_REQUIRED_ROLES=admin,ops        # with enforcement=roles
# AUTH_MFA_UNENROLLED=allow                # allow (password-only tokens) | deny
# AUTH_MFA_METHODS=totp                    # any of totp,email,sms, preferred first
# AUTH_MFA_ENCRYPTION_KEY=                 # base64, 32 bytes – seals TOTP secrets and destinations
# AUTH_MFA_PREVIOUS_ENCRYPTION_KEYS=       # comma-separated, still accepted for opening
# AUTH_MFA_HASH_KEY=                       # base64, ≥ 32 bytes – HMAC of codes and challenges
# AUTH_MFA_TOTP_ISSUER=                    # default: AUTH_JWT_ISSUER
# AUTH_MFA_TOTP_ALGORITHM=sha1             # sha1 | sha256 | sha512
# AUTH_MFA_TOTP_DIGITS=6                   # 6–8
# AUTH_MFA_TOTP_PERIOD_SECS=30
# AUTH_MFA_TOTP_SKEW_STEPS=1               # 0–5
# AUTH_MFA_TOTP_SECRET_BYTES=20            # 16–64
# AUTH_MFA_ENROLLMENT_TTL_SECS=600
# AUTH_MFA_RECOVERY_CODE_COUNT=10          # 0 = no recovery codes
# AUTH_MFA_RECOVERY_CODE_LENGTH=10         # 8–32
# AUTH_MFA_CHALLENGE_TTL_SECS=300
# AUTH_MFA_CHALLENGE_MAX_ATTEMPTS=5
# AUTH_MFA_CHALLENGE_MATCH=none            # none | any of ip,user_agent,fingerprint
# AUTH_MFA_LOCKOUT_THRESHOLD=10            # failures per window; 0 = never lock
# AUTH_MFA_LOCKOUT_WINDOW_SECS=900
# AUTH_MFA_LOCKOUT_SECS=900
# AUTH_MFA_CODE_DIGITS=6                   # email / SMS codes, 6–10
# AUTH_MFA_CODE_TTL_SECS=300
# AUTH_MFA_CODE_RESEND_SECS=30
# AUTH_MFA_CODE_MAX_SENDS=5
# AUTH_MFA_AUTO_SEND=true                  # send at login when the user has no TOTP
# AUTH_MFA_END_SESSIONS_ON_REMOVAL=true
# AUTH_MFA_PURGE_INTERVAL_SECS=300
# AUTH_MFA_PURGE_RETENTION_SECS=86400

# ── z-auth-mfa-sender (optional) — read by DeliveryConfig::from_env ───────
# Who delivers email / SMS codes; `log` only writes them to the log.
# AUTH_MFA_EMAIL_PROVIDER=log              # log | smtp | sendgrid | postmark | mailgun
# AUTH_MFA_SMS_PROVIDER=log                # log | twilio | webhook
# AUTH_MFA_SENDER_NAME=                    # default: AUTH_MFA_TOTP_ISSUER, then AUTH_JWT_ISSUER
# AUTH_MFA_EMAIL_FROM=no-reply@example.com # every email provider but log
# AUTH_MFA_DELIVERY_TIMEOUT_SECS=10
# AUTH_MFA_SMTP_HOST=smtp.example.com
# AUTH_MFA_SMTP_SECURITY=starttls          # starttls | tls | none (local dev only)
# AUTH_MFA_SMTP_PORT=587                   # default by security: 587 / 465 / 25
# AUTH_MFA_SMTP_USERNAME=                  # with AUTH_MFA_SMTP_PASSWORD, or neither
# AUTH_MFA_SMTP_PASSWORD=
# AUTH_MFA_SENDGRID_API_KEY=
# AUTH_MFA_POSTMARK_SERVER_TOKEN=
# AUTH_MFA_POSTMARK_MESSAGE_STREAM=outbound
# AUTH_MFA_MAILGUN_API_KEY=
# AUTH_MFA_MAILGUN_DOMAIN=mg.example.com
# AUTH_MFA_MAILGUN_REGION=us               # us | eu
# AUTH_MFA_TWILIO_ACCOUNT_SID=
# AUTH_MFA_TWILIO_AUTH_TOKEN=
# AUTH_MFA_TWILIO_FROM=+15550001111        # or AUTH_MFA_TWILIO_MESSAGING_SERVICE_SID, exactly one
# AUTH_MFA_TWILIO_MESSAGING_SERVICE_SID=
# AUTH_MFA_SMS_WEBHOOK_URL=https://sms-gateway.internal/send
# AUTH_MFA_SMS_WEBHOOK_SECRET=             # HMAC-SHA256 signature (X-ZAuth-Signature)
# AUTH_MFA_SMS_WEBHOOK_BEARER_TOKEN=

# ── z-auth-sso (optional) — read by z_auth_sso::config::SsoEnvLoader ──────
# Only for the service that imports z-auth-sso (needs
# ZAuthBuilder::external_identities).  Providers usually live in the
# `sso.providers` section of the YAML file; any of their settings can be
# set or overridden here as AUTH_SSO_<NAME>_<SETTING>.
# AUTH_SSO_CALLBACK_URL=https://auth.example.com/auth/sso/callback   # required
# AUTH_SSO_FLOW_TTL_SECS=600               # redirect to the provider stays valid
# AUTH_SSO_BINDING_TRANSPORT=cookie        # cookie | header – how the browser binding reaches the callback; cannot be off
# AUTH_SSO_BINDING_NAME=                   # default __Host-sso-binding (https), sso-binding (localhost), X-SSO-Binding (header)
# AUTH_SSO_PROVIDERS=google                # providers configured here only, comma-separated
# AUTH_SSO_GOOGLE_KIND=oidc                # oidc | oauth2 | github
# AUTH_SSO_GOOGLE_ISSUER=https://accounts.google.com
# AUTH_SSO_GOOGLE_CLIENT_ID=
# AUTH_SSO_GOOGLE_CLIENT_SECRET=
# AUTH_SSO_GOOGLE_LINK=confirm_with_password   # never | confirm_with_password | verified_email
# AUTH_SSO_GOOGLE_PROVISIONING=deny        # deny | create
# AUTH_SSO_GOOGLE_TRUST_EMAIL=false        # rely on the provider's email_verified
# AUTH_SSO_GOOGLE_MAX_LINKS=1              # identities of this provider per user; 0 = unlimited

# ── z-auth-postgres (reference adapter) — read by PgConfig::from_env ────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=auth                  # optional – defaults to "auth" if omitted
DB_MAX_POOL_SIZE=10           # optional
DB_CONNECT_TIMEOUT_SECS=5     # optional
