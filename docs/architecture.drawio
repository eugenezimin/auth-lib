" as="geometry"/></mxCell><mxCell id="overview-v22" value="&lt;b&gt;ClusterService&lt;/b&gt;&lt;br&gt;membership · push · repair" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="overview-v14"><mxGeometry x="20" y="270" width="260" height="56" as="geometry"/></mxCell><mxCell id="overview-v23" value="&lt;b&gt;KeyService&lt;/b&gt;&lt;br&gt;publish verifying keys · revoke signing keys" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="overview-v14"><mxGeometry x="290" y="270" width="270" height="56" as="geometry"/></mxCell><mxCell id="overview-v24" value="&lt;b&gt;TokenVerifier&lt;/b&gt;&lt;br&gt;signature · exp · denylist" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;" vertex="1" parent="overview-v14"><mxGeometry x="20" y="346" width="170" height="66" as="geometry"/></mxCell><mxCell id="overview-v25" value="&lt;b&gt;Authorizer&lt;/b&gt;&lt;br&gt;roles · permission decode" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;" vertex="1" parent="overview-v14"><mxGeometry x="205" y="346" width="170" height="66" as="geometry"/></mxCell><mxCell id="overview-v26" value="&lt;b&gt;Denylist · KeyRing&lt;/b&gt;&lt;br&gt;&lt;b&gt;CatalogCache&lt;/b&gt; — replicated, in memory" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;" vertex="1" parent="overview-v14"><mxGeometry x="390" y="346" width="170" height="66" as="geometry"/></mxCell><mxCell id="overview-v27" value="&lt;b&gt;PasswordHasher&lt;/b&gt;&lt;br&gt;→ Argon2Hasher" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="overview-v14"><mxGeometry x="20" y="430" width="170" height="56" as="geometry"/></mxCell><mxCell id="overview-v28" value="&lt;b&gt;AccessTokenIssue