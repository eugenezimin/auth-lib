ize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="harness-v9" target="harness-v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="harness-e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="harness-v22" target="harness-v25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="harness-e42" value="handlers::*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="harness-v25" target="harness-v34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="harness-e43" value="Claims" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#4d9900;fontColor=#336600;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="harness-v26" target="harness-v27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="harness-e44" value="authorizer()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#4d9900;fontColor=#336600;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="harness-v27" target="harness-v34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="harness-e45" value="ports" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=0;dashed=1;strokeColor=#82b366;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="harness-v34" target="harness-v35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="harness-e46" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontColor=#9a5b00;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="harness-v35" target="harness-v36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="cluster" name="8 · Cluster sync"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cluster-v1" value="Cluster sync — instances know each other and push every change" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1680" height="36" as="geometry"/></mxCell><mxCell id="cluster-v2" value="auth-lib ships no client and no server: the host provides the transport (outbound) and the endpoint (inbound) and calls the library's methods. Replicated state lives in memory on every instance; verification never touches the database." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1680" height="36" as="geometry"/></mxCell><mxCell id="cluster-v3" value="auth-lib instance (any service)" style="swimlane;html=1;rounded=1;arcSize=1;startSize=28;fontStyle=1;fontSize=13;fillColor=#f7f7f7;strokeColor=#999999;swimlaneFillColor=#fbfbfb;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="780" height="600" as="geometry"/></mxCell><mxCell id="cluster-v4" value="&lt;b&gt;Host inbound endpoint&lt;/b&gt; &lt;font color=#555&gt;(user-provided)&lt;/font&gt;&lt;br&gt;e.g. POST /internal/cluster → &lt;i&gt;cluster().receive(envelope)&lt;/i&gt;" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="cluster-v3"><mxGeometry x="20" y="44" width="350" height="60" as="geometry"/></mxCell><mxCell id="cluster-v5" value="&lt;b&gt;Host ClusterTransport&lt;/b&gt; &lt;font color=#555&gt;(user-provided)&lt;/font&gt;&lt;br&gt;HTTP / gRPC / bus client · &lt;i&gt;send(to, envelope) → reply&lt;/i&gt;" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="cluster-v3"><mxGeometry x="410" y="44" width="350" height="60" as="geometry"/></mxCell><mxCell id="cluster-v6" value="&lt;b&gt;ClusterServiceImpl&lt;/b&gt; — start · tick · receive · leave" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="cluster-v3"><mxGeometry x="20" y="130" width="740" height="50" as="geometry"/></mxCell><mxCell id="cluster-v7" value="&lt;b&gt;receive()&lt;/b&gt; checks: MAC · not from self · |now − sent_at| ≤ 30 s · known sender (join / heartbeat introduce) · message id not seen → apply → reply" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="cluster-v3"><mxGeometry x="20" y="206" width="350" height="80" as="geometry"/></mxCell><mxCell id="cluster-v8" value="&lt;b&gt;ClusterMessenger&lt;/b&gt;&lt;br&gt;seal (HMAC-SHA256) · send · broadcast to current peers (concurrent) · outbox retries (5)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="cluster-v3"><mxGeometry x="410" y="206" width="350" height="80" as="geometry"/></mxCell><mxCell id="cluster-v9" value="&lt;b&gt;ClusterState&lt;/b&gt; (memory)&lt;br&gt;peers: online · offline · tombstones (probed) · seen ids · snapshot requests" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;" vertex="1" parent="cluster-v3"><mxGeometry x="20" y="312" width="350" height="70" as="geometry"/></mxCell><mxCell id="cluster-v10" value="&lt;b&gt;Replicated state&lt;/b&gt; (memory)&lt;br&gt;Denylist · KeyRing · CatalogCache → digest in every heartbeat" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;" vertex="1" parent="cluster-v3"><mxGeometry x="410" y="312" width="350" height="70" as="geometry"/></mxCell><mxCell id="cluster-v11" value="&lt;b&gt;EventPublisher → ClusterPublisher&lt;/b&gt; (via ClusterMessenger) ← TokenRevocationService · KeyService · PermissionService publish DomainEvents: revoked · revocation_enforced · verifying_key_published · signing_key_revoked · catalog_changed" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="cluster-v3"><mxGeometry x="20" y="408" width="740" height="60" as="geometry"/></mxCell><mxCell id="cluster-v12" value="&lt;b&gt;NodeRepository&lt;/b&gt; (registry state machine)&lt;br&gt;register · restore · guarded transition · list at start" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="cluster-v3"><mxGeometry x="20" y="494" width="350" height="64" as="geometry"/></mxCell><mxCell id="cluster-v13" value="&lt;b&gt;AuthLib&lt;/b&gt; — start() once · tick() every heartbeat · shutdown()" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="cluster-v3"><mxGeometry x="410" y="494" width="350" height="64" as="geometry"/></mxCell><mxCell id="cluster-e14" value="receive" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cluster-v4" target="cluster-v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cluster-e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#4d9900;fontColor=#336600;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cluster-v6" target="cluster-v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cluster-e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cluster-v6" target="cluster-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cluster-e17" value="send" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cluster-v8" target="cluster-v5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="346"/><mxPoint x="810" y="174"/></Array></mxGeometry></mxCell><mxCell id="cluster-e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#4d9900;fontColor=#336600;" edge="1" parent="1" source="cluster-v7" target="cluster-v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cluster-e19" value="apply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#4d9900;fontColor=#336600;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cluster-v7" target="cluster-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cluster-v20" value="&lt;b&gt;instance B&lt;/b&gt;&lt;br&gt;orders service · 10.0.0.12:8443" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="900" y="140" width="250" height="70" as="geometry"/></mxCell><mxCell id="cluster-v21" value="&lt;b&gt;instance C&lt;/b&gt;&lt;br&gt;auth service replica · auth-2.internal" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="900" y="260" width="250" height="70" as="geometry"/></mxCell><mxCell id="cluster-v22" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;cluster_nodes · revocations&lt;br&gt;verifying_keys" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="540" width="180" height="120" as="geometry"/></mxCell><mxCell id="cluster-e23" value="signed envelopes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontColor=#6a4c80;startArrow=block;startFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cluster-v5" target="cluster-v20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cluster-e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontColor=#6a4c80;startArrow=block;startFill=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cluster-v5" target="cluster-v21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cluster-e25" value="startup · rare" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontColor=#9a5b00;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cluster-v12" target="cluster-v22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="235" y="680"/><mxPoint x="900" y="680"/><mxPoint x="900" y="600"/></Array></mxGeometry></mxCell><mxCell id="cluster-v26" value="&lt;b&gt;Messages&lt;/b&gt; (payload.type)&lt;br&gt;&lt;table border=1 cellpadding=3 style='border-collapse:collapse;font-size:11px'&gt;&lt;tr&gt;&lt;th&gt;type&lt;/th&gt;&lt;th&gt;sent&lt;/th&gt;&lt;th&gt;reply&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;join&lt;/td&gt;&lt;td&gt;start, to every registered node&lt;/td&gt;&lt;td&gt;snapshot&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;heartbeat&lt;/td&gt;&lt;td&gt;every tick: info · members · digest&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;event&lt;/td&gt;&lt;td&gt;immediately on every change&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;snapshot_request&lt;/td&gt;&lt;td&gt;digest differs (rate-limited)&lt;/td&gt;&lt;td&gt;snapshot&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;snapshot&lt;/td&gt;&lt;td&gt;reply: revocations · keys · catalog version&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;leave&lt;/td&gt;&lt;td&gt;graceful shutdown&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfae5a;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1190" y="100" width="530" height="250" as="geometry"/></mxCell><mxCell id="cluster-v27" value="&lt;b&gt;Envelope&lt;/b&gt; { message_id, from, sent_at, payload, mac }&lt;br&gt;mac = base64url(HMAC-SHA256(AUTH_CLUSTER_SECRET, JSON of the other fields)) — the secret proves membership on any transport; replies are signed too." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfae5a;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1190" y="370" width="530" height="90" as="geometry"/></mxCell><mxCell id="cluster-v28" value="&lt;b&gt;Registry state machine&lt;/b&gt; (written only on these events)&lt;br&gt;state: joining → active → leaving → deleted&lt;br&gt;heartbeat: online → &lt;b&gt;offline&lt;/b&gt; after 1 missed beat → &lt;b&gt;deleted&lt;/b&gt; if still silent at the next · heard again → online&lt;br&gt;every observer tries a guarded update; exactly one changes the row · deleted peers stay probed as tombstones" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfae5a;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1190" y="480" width="530" height="110" as="geometry"/></mxCell><mxCell id="cluster-v29" value="&lt;b&gt;Revocation timeline&lt;/b&gt;&lt;br&gt;1 revoke on any instance: session ended + &lt;b&gt;pending&lt;/b&gt; revocation stored&lt;br&gt;2 Denylist.apply locally + push &lt;i&gt;revoked&lt;/i&gt; → every instance blocks at once&lt;br&gt;3 a covered token is presented anywhere → 401 + enforcement hit&lt;br&gt;4 that instance's tick: CAS pending → &lt;b&gt;enforced&lt;/b&gt;, session &lt;b&gt;compromised&lt;/b&gt;&lt;br&gt;5 push &lt;i&gt;revocation_enforced&lt;/i&gt; → everyone marks it enforced" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfae5a;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="560" height="150" as="geometry"/></mxCell><mxCell id="cluster-v30" value="&lt;b&gt;Delivery guarantees&lt;/b&gt;&lt;br&gt;• push: immediate, concurrent, to all current peers (online or offline)&lt;br&gt;• retry: in-memory outbox, up to 5 ticks&lt;br&gt;• repair: digest mismatch → snapshot; union merge (enforced wins, revoked key wins, newer catalog wins)&lt;br&gt;• restart: start() loads revocations / keys / catalog, then join replies add newer state" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfae5a;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="730" width="560" height="150" as="geometry"/></mxCell><mxCell id="cluster-v31" value="&lt;b&gt;Database touch points&lt;/b&gt;&lt;br&gt;verification · authorization · heartbeats · receiving pushes: &lt;b&gt;none&lt;/b&gt;&lt;br&gt;start(): register + read nodes, revocations, keys · revoke / enforce / key events: the recording write · catalog_changed received: one reload · node state change: one guarded registry write" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfae5a;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="730" width="520" height="150" as="geometry"/></mxCell><mxCell id="cluster-v32" value="Legend" style="swimlane;html=1;rounded=1;arcSize=1;startSize=28;fontStyle=1;fontSize=13;fillColor=#f7f7f7;strokeColor=#999999;swimlaneFillColor=#fbfbfb;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="250" height="154" as="geometry"/></mxCell><mxCell id="cluster-v33" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="cluster-v32"><mxGeometry x="12" y="36" width="34" height="20" as="geometry"/></mxCell><mxCell id="cluster-v34" value="Host-provided (transport / endpoint)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="cluster-v32"><mxGeometry x="54" y="32" width="190" height="28" as="geometry"/></mxCell><mxCell id="cluster-v35" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="cluster-v32"><mxGeometry x="12" y="66" width="34" height="20" as="geometry"/></mxCell><mxCell id="cluster-v36" value="auth-lib service" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="cluster-v32"><mxGeometry x="54" y="62" width="190" height="28" as="geometry"/></mxCell><mxCell id="cluster-v37" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;" vertex="1" parent="cluster-v32"><mxGeometry x="12" y="96" width="34" height="20" as="geometry"/></mxCell><mxCell id="cluster-v38" value="In memory, no I/O" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="cluster-v32"><mxGeometry x="54" y="92" width="190" height="28" as="geometry"/></mxCell><mxCell id="cluster-v39" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="cluster-v32"><mxGeometry x="12" y="126" width="34" height="20" as="geometry"/></mxCell><mxCell id="cluster-v40" value="Port" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="cluster-v32"><mxGeometry x="54" y="122" width="190" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
