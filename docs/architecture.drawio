2" y="96" width="34" height="20" as="geometry"/></mxCell><mxCell id="overview-v56" value="auth-lib service (trait → impl)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="overview-v50"><mxGeometry x="54" y="92" width="190" height="28" as="geometry"/></mxCell><mxCell id="overview-v57" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="overview-v50"><mxGeometry x="12" y="126" width="34" height="20" as="geometry"/></mxCell><mxCell id="overview-v58" value="Port (trait the host implements)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="overview-v50"><mxGeometry x="54" y="122" width="190" height="28" as="geometry"/></mxCell><mxCell id="overview-v59" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="overview-v50"><mxGeometry x="12" y="156" width="34" height="20" as="geometry"/></mxCell><mxCell id="overview-v60" value="Adapter implementation" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="overview-v50"><mxGeometry x="54" y="152" width="190" height="28" as="geometry"/></mxCell><mxCell id="overview-v61" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;" vertex="1" parent="overview-v50"><mxGeometry x="12" y="186" width="34" height="20" as="geometry"/></mxCell><mxCell id="overview-v62" value="In-memory, no I/O" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="overview-v50"><mxGeometry x="54" y="182" width="190" height="28" as="geometry"/></mxCell><mxCell id="overview-v63" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="overview-v50"><mxGeometry x="12" y="216" width="34" height="20" as="geometry"/></mxCell><mxCell id="overview-v64" value="Crypto / codec" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="overview-v50"><mxGeometry x="54" y="212" width="190" height="28" as="geometry"/></mxCell><mxCell id="overview-v65" value="&lt;b&gt;Request path&lt;/b&gt; (green): Bearer → TokenVerifier → Authorizer, in memory.&lt;br&gt;&lt;b&gt;Store path&lt;/b&gt; (orange): login / refresh, admin changes, startup.&lt;br&gt;&lt;b&gt;Cluster path&lt;/b&gt; (purple): every change is pushed to all instances immediately; heartbeats repair anything missed." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfae5a;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="690" width="330" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="modules" name="2 · auth-lib modules"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2140" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="modules-v1" value="auth-lib — bounded contexts, ports and implementations" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2060" height="36" as="geometry"/></mxCell><mxCell id="modules-v2" value="Each context follows model.rs → repository.rs (ports) → service.rs (trait) → service_impl.rs. The facade wires every *Impl; adapters (and the host's transport) implement the ports. Only models and DTOs cross interfaces." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="2060" height="36" as="geometry"/></mxCell><mxCell id="modules-v3" value="&lt;b&gt;AuthLib / AuthLibBuilder&lt;/b&gt; (facade.rs) — builder(config, &lt;b&gt;Repositories&lt;/b&gt;): users · roles · user_roles · sessions · revocations · keys (required, compile-checked) · .permissions(…) (permission modes). Defaults: Argon2Hasher, Ed25519 issuer/decoder, HmacRefreshCodec, BitsetPermissionCodec, SystemClock. Shares one Denylist, KeyRing and CatalogCache · lifecycle: start · tick · shutdown · optional .cluster(transport, nodes)." style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="2060" height="54" as="geometry"/></mxCell><mxCell id="modules-v4" value="user" style="swimlane;html=1;rounded=1;arcSize=1;startSize=28;fontStyle=1;fontSize=13;fillColor=#f7f7f7;strokeColor=#999999;swimlaneFillColor=#fbfbfb;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="250" height="304" as="geometry"/></mxCell><mxCell id="modules-v5" value="&lt;b&gt;UserService&lt;/b&gt; → UserServiceImpl&lt;br&gt;&lt;font color=#555&gt;register · update · deactivate · delete&lt;br&gt;ends sessions on password change / disable / delete&lt;/font&gt;" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="modules-v4"><mxGeometry x="12" y="38" width="226" height="84" as="geometry"/></mxCell><mxCell id="modules-v6" value="&lt;b&gt;model&lt;/b&gt;: User · NewUser · UpdateUser · UserUpdate · UserWithRoles · RegisterUser" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="modules-v4"><mxGeometry x="12" y="132" width="226" height="56" as="geometry"/></mxCell><mxCell id="modules-v7" value="&lt;b&gt;validation&lt;/b&gt;: validate_email · normalize_email" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="modules-v4"><mxGeometry x="12" y="198" width="226" height="44" as="geometry"/></mxCell><mxCell id="modules-v8" value="&lt;b&gt;UserRepository&lt;/b&gt; (port)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="modules-v4"><mxGeometry x="12" y="252" width="226" height="40" as="geometry"/></mxCell><mxCell id="modules-v9" value="access (roles)" style="swimlane;html=1;rounded=1;arcSize=1;startSize=28;fontStyle=1;fontSize=13;fillColor=#f7f7f7;strokeColor=#999999;swimlaneFillColor=#fbfbfb;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="310" y="170" width="250" height="286" as="geometry"/></mxCell><mxCell id="modules-v10" value="&lt;b&gt;RoleService&lt;/b&gt; → RoleServiceImpl&lt;br&gt;&lt;font color=#555&gt;mode-gated (rbac · combined)&lt;br&gt;code validated&lt;/font&gt;" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="modules-v9"><mxGeometry x="12" y="38" width="226" height="70" as="geometry"/></mxCell><mxCell id="modules-v11" value="&lt;b&gt;model&lt;/b&gt;: Role { id, &lt;b&gt;code&lt;/b&gt;, name, description } · NewRole · UserRole" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="modules-v9"><mxGeometry x="12" y="118" width="226" height="56" as="geometry"/></mxCell><mxCell id="modules-v12" value="&lt;b&gt;RoleRepository&lt;/b&gt; (port)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="modules-v9"><mxGeometry x="12" y="184" width="226" height="40" as="geometry"/></mxCell><mxCell id="modules-v13" value="&lt;b&gt;UserRoleRepository&lt;/b&gt; (port)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="modules-v9"><mxGeometry x="12" y="234" width="226" height="40" as="geometry"/></mxCell><mxCell id="modules-v14" value="authorization" style="swimlane;html=1;rounded=1;arcSize=1;startSize=28;fontStyle=1;fontSize=13;fillColor=#f7f7f7;strokeColor=#999999;swimlaneFillColor=#fbfbfb;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="580" y="170" width="330" height="546" as="geometry"/></mxCell><mxCell id="modules-v15" value="&lt;b&gt;PermissionService&lt;/b&gt; → PermissionServiceImpl&lt;br&gt;&lt;font color=#555&gt;catalog CRUD · user / role grants · catalog() from cache · reload_catalog()&lt;/font&gt;" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="modules-v14"><mxGeometry x="12" y="38" width="306" height="70" as="geometry"/></mxCell><mxCell id="modules-v16" value="&lt;b&gt;AuthzClaimsProvider&lt;/b&gt; → AuthzClaimsProviderImpl&lt;br&gt;&lt;font color=#555&gt;login / refresh: roles + effective grants → AuthzClaims&lt;/font&gt;" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="modules-v14"><mxGeometry x="12" y="118" width="306" height="70" as="geometry"/></mxCell><mxCell id="modules-v17" value="&lt;b&gt;Authorizer&lt;/b&gt; → AuthorizerImpl&lt;br&gt;&lt;font color=#555&gt;has_role · roles · permissions() — no I/O&lt;/font&gt;" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;" vertex="1" parent="modules-v14"><mxGeometry x="12" y="198" width="306" height="56" as="geometry"/></mxCell><mxCell id="modules-v18" value="&lt;b&gt;PermissionCodec&lt;/b&gt; → BitsetPermissionCodec (v1)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="modules-v14"><mxGeometry x="12" y="264" width="306" height="40" as="geometry"/></mxCell><mxCell id="modules-v19" value="&lt;b&gt;CatalogCache&lt;/b&gt; — in-memory catalog" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;" vertex="1" parent="modules-v14"><mxGeometry x="12" y="314" width="306" height="40" as="geometry"/></mxCell><mxCell id="modules-v20" value="&lt;b&gt;model&lt;/b&gt;: Permission · PermissionKind · PermissionOption · NewPermission · PermissionValue · PermissionAssignment · PermissionCatalog · PermissionGrant · EffectiveGrants · EffectivePermissions" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="modules-v14"><mxGeometry x="12" y="364" width="306" height="70" as="geometry"/></mxCell><mxCell id="modules-v21" value="&lt;b&gt;validation&lt;/b&gt;: validate_code · assignment_for" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="modules-v14"><mxGeometry x="12" y="444" width="306" height="40" as="geometry"/></mxCell><mxCell id="modules-v22" value="&lt;b&gt;PermissionRepository&lt;/b&gt; (port)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="modules-v14"><mxGeometry x="12" y="494" width="306" height="40" as="geometry"/></mxCell><mxCell id="modules-v23" value="authentication" style="swimlane;html=1;rounded=1;arcSize=1;startSize=28;fontStyle=1;fontSize=13;fillColor=#f7f7f7;strokeColor=#999999;swimlaneFillColor=#fbfbfb;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="930" y="170" width="280" height="330" as="geometry"/></mxCell><mxCell id="modules-v24" value="&lt;b&gt;AuthenticationService&lt;/b&gt; → AuthenticationServiceImpl&lt;br&gt;&lt;font color=#555&gt;login · refresh · logout · logout_all · verify_access_token · purge_sessions&lt;/font&gt;" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="modules-v23"><mxGeometry x="12" y="38" width="256" height="84" as="geometry"/></mxCell><mxCell id="modules-v25" value="&lt;b&gt;policy&lt;/b&gt;: evaluate_refresh — pure function&lt;br&gt;Rotate · ReturnCurrent · Compromise · Reject" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="modules-v23"><mxGeometry x="12" y="132" width="256" height="56" as="geometry"/></mxCell><mxCell id="modules-v26" value="&lt;b&gt;model&lt;/b&gt;: Session · SessionGeneration · NewSession · SessionLifetimes · RefreshSnapshot · RotateOutcome · TokenPair · Credentials · ClientContext" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="modules-v23"><mxGeometry x="12" y="198" width="256" height="70" as="geometry"/></mxCell><mxCell id="modules-v27" value="&lt;b&gt;SessionRepository&lt;/b&gt; (port)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="modules-v23"><mxGeometry x="12" y="278" width="256" height="40" as="geometry"/></mxCell><mxCell id="modules-v28" value="token" style="swimlane;html=1;rounded=1;arcSize=1;startSize=28;fontStyle=1;fontSize=13;fillColor=#f7f7f7;strokeColor=#999999;swimlaneFillColor=#fbfbfb;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1230" y="170" width="300" height="632" as="geometry"/></mxCell><mxCell id="modules-v29" value="&lt;b&gt;TokenRevocationService&lt;/b&gt; → TokenRevocationServiceImpl&lt;br&gt;&lt;font color=#555&gt;revoke (pending) · load · enforce_pending · purge_expired&lt;/font&gt;" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="modules-v28"><mxGeometry x="12" y="38" width="276" height="70" as="geometry"/></mxCell><mxCell id="modules-v30" value="&lt;b&gt;KeyService&lt;/b&gt; → KeyServiceImpl&lt;br&gt;&lt;font color=#555&gt;publish verifying key · revoke signing key&lt;/font&gt;" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="modules-v28"><mxGeometry x="12" y="118" width="276" height="56" as="geometry"/></mxCell><mxCell id="modules-v3