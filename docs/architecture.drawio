roles / permissions" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#fff2e0;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="authn-v21"><mxGeometry x="14" y="274" width="512" height="34" as="geometry"/></mxCell><mxCell id="authn-v27" value="&lt;b&gt;6&lt;/b&gt; SessionRepository.&lt;b&gt;load_for_refresh&lt;/b&gt;(sid, gen)&lt;br&gt;session + presented + current generation + now()" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#fff2e0;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="authn-v21"><mxGeometry x="14" y="330" width="512" height="48" as="geometry"/></mxCell><mxCell id="authn-v28" value="&lt;b&gt;7&lt;/b&gt; RefreshTokenCodec.verify — MAC vs session secret" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="authn-v21"><mxGeometry x="14" y="400" width="512" height="34" as="geometry"/></mxCell><mxCell id="authn-v29" value="&lt;b&gt;8&lt;/b&gt; &lt;b&gt;evaluate_refresh&lt;/b&gt; (pure policy) → Rotate · ReturnCurrent · Compromise · Reject" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="authn-v21"><mxGeometry x="14" y="456" width="512" height="44" as="geometry"/></mxCell><mxCell id="authn-v30" value="&lt;b&gt;9a Rotate&lt;/b&gt;: SessionRepository.&lt;b&gt;rotate&lt;/b&gt; — CAS on current_generation (Conflict → retry ≤ 3)&lt;br&gt;&lt;b&gt;9b ReturnCurrent&lt;/b&gt;: concurrent refresh within grace → current pair again&lt;br&gt;&lt;b&gt;9c Compromise&lt;/b&gt;: end_session(TokenReuse / IpMismatch) → 401" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#fff2e0;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="authn-v21"><mxGeometry x="14" y="522" width="512" height="72" as="geometry"/></mxCell><mxCell id="authn-v31" value="&lt;b&gt;10&lt;/b&gt; → new TokenPair carrying &lt;b&gt;current&lt;/b&gt; authorization claims" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="authn-v21"><mxGeometry x="14" y="616" width="512" height="34" as="geometry"/></mxCell><mxCell id="authn-e32" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="authn-v22" target="authn-v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authn-e33" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="authn-v23" target="authn-v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authn-e34" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="authn-v24" target="authn-v25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authn-e35" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="authn-v25" target="authn-v26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authn-e36" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="authn-v26" target="authn-v27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authn-e37" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="authn-v27" target="authn-v28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authn-e38" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="authn-v28" target="authn-v29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authn-e39" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="authn-v29" target="authn-v30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authn-e40" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="authn-v30" target="authn-v31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authn-v41" value="Verify — every protected request" style="swimlane;html=1;rounded=1;arcSize=1;startSize=28;fontStyle=1;fontSize=13;fillColor=#f7f7f7;strokeColor=#999999;swimlaneFillColor=#fbfbfb;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1160" y="100" width="520" height="404" as="geometry"/></mxCell><mxCell id="authn-v42" value="&lt;b&gt;1&lt;/b&gt; Authorization: Bearer &amp;lt;access JWT&amp;gt;" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="authn-v41"><mxGeometry x="14" y="40" width="492" height="34" as="geometry"/></mxCell><mxCell id="authn-v43" value="&lt;b&gt;2&lt;/b&gt; Ed25519Decoder: alg = EdDSA only · kid → verifying key · signature · iss · iat · exp ± leeway" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="authn-v41"><mxGeometry x="14" y="96" width="492" height="48" as="geometry"/></mxCell><mxCell id="authn-v44" value="&lt;b&gt;3&lt;/b&gt; Denylist.check: session entry · user cutoff (iat ≤ revoked_at)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="authn-v41"><mxGeometry x="14" y="166" width="492" height="34" as="geometry"/></mxCell><mxCell id="authn-v45" value="&lt;b&gt;4&lt;/b&gt; Claims { sub, sid, jti, gen, authz { roles, permissions } }" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="authn-v41"><mxGeometry x="14" y="222" width="492" height="34" as="geometry"/></mxCell><mxCell id="authn-v46" value="&lt;b&gt;5&lt;/b&gt; Authorizer.has_role / permissions() — decode prm with CatalogCache" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="authn-v41"><mxGeometry x="14" y="278" width="492" height="44" as="geometry"/></mxCell><mxCell id="authn-v47" value="&lt;b&gt;6&lt;/b&gt; application decides: allow · 403 forbidden" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="authn-v41"><mxGeometry x="14" y="344" width="492" height="34" as="geometry"/></mxCell><mxCell id="authn-e48" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="authn-v42" target="authn-v43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authn-e49" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="authn-v43" target="authn-v44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authn-e50" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="authn-v44" target="authn-v45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authn-e51" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="authn-v45" target="authn-v46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authn-e52" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="authn-v46" target="authn-v47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authn-v53" value="&lt;b&gt;No store access on this path.&lt;/b&gt;&lt;br&gt;Verification uses only the signing keys, the in-memory Denylist and the CatalogCache. Role / permission changes reach the token at the next refresh." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfae5a;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1160" y="560" width="520" height="76" as="geometry"/></mxCell><mxCell id="authn-v54" value="&lt;b&gt;Errors&lt;/b&gt; → ApiError: invalid_credentials 401 · account_disabled 403 · invalid_token 401 · token_revoked 401 · session_expired 401 · session_compromised 401" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfae5a;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1160" y="660" width="520" height="70" as="geometry"/></mxCell><mxCell id="authn-v55" value="Legend" style="swimlane;html=1;rounded=1;arcSize=1;startSize=28;fontStyle=1;fontSize=13;fillColor=#f7f7f7;strokeColor=#999999;swimlaneFillColor=#fbfbfb;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1160" y="750" width="250" height="124" as="geometry"/></mxCell><mxCell id="authn-v56" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#fff2e0;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="authn-v55"><mxGeometry x="12" y="36" width="34" height="20" as="geometry"/></mxCell><mxCell id="authn-v57" value="Store read / write" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="authn-v55"><mxGeometry x="54" y="32" width="190" height="28" as="geometry"/></mxCell><mxCell id="authn-v58" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="authn-v55"><mxGeometry x="12" y="66" width="34" height="20" as="geometry"/></mxCell><mxCell id="authn-v59" value="Pure memory / crypto" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="authn-v55"><mxGeometry x="54" y="62" width="190" height="28" as="geometry"/></mxCell><mxCell id="authn-v60" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="authn-v55"><mxGeometry x="12" y="96" width="34" height="20" as="geometry"/></mxCell><mxCell id="authn-v61" value="Input / output" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="authn-v55"><mxGeometry x="54" y="92" width="190" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="authz" name="4 · Authorization"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1160" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="authz-v1" value="Authorization — RBAC, permissions or combined, carried in the token" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1680" height="36" as="geometry"/></mxCell><mxCell id="authz-v2" value="AUTH_AUTHZ_MODE selects the model. Data is minted into the JWT at login / refresh, checked from the token on every request, and decoded by UIs with a separately downloaded, versioned catalog." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1680" height="36" as="geometry"/></mxCell><mxCell id="authz-v3" value="&lt;b&gt;Modes&lt;/b&gt; (AUTH_AUTHZ_MODE)&lt;br&gt;&lt;table border=1 cellpadding=4 style='border-collapse:collapse;font-size:11px'&gt;&lt;tr&gt;&lt;th&gt;mode&lt;/th&gt;&lt;th&gt;token&lt;/th&gt;&lt;th&gt;services&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;none&lt;/td&gt;&lt;td&gt;identity only&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;rbac (default)&lt;/td&gt;&lt;td&gt;rol&lt;/td&gt;&lt;td&gt;RoleService&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;permissions&lt;/td&gt;&lt;td&gt;prm · pv&lt;/td&gt;&lt;td&gt;PermissionService&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;combined&lt;/td&gt;&lt;td&gt;rol · prm · pv&lt;/td&gt;&lt;td&gt;both + role grants&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;font color=#555&gt;other services → 409 authz_mode_disabled&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfae5a;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="330" height="210" as="geometry"/></mxCell><mxCell id="authz-v4" value="Mint — login / refresh (store)" style="swimlane;html=1;rounded=1;arcSize=1;startSize=28;fontStyle=1;fontSize=13;fillColor=#f7f7f7;strokeColor=#999999;swimlaneFillColor=#fbfbfb;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="860" height="260" as="geometry"/></mxCell><mxCell id="authz-v5" value="&lt;b&gt;UserWithRoles&lt;/b&gt;&lt;br&gt;roles → rol (rbac / combined)&lt;br&gt;&lt;font color=#555&gt;already loaded by login / refresh&lt;/font&gt;" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="authz-v4"><mxGeometry x="14" y="44" width="190" height="70" as="geometry"/></mxCell><mxCell id="authz-v6" value="&lt;b&gt;AuthzClaimsProviderImpl&lt;/b&gt;&lt;br&gt;claims_for(account)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="authz-v4"><mxGeometry x="240" y="44" width="190" height="70" as="geometry"/></mxCell><mxCell id="authz-v7" value="&lt;b&gt;PermissionRepository&lt;/b&gt;&lt;br&gt;effective_grants(user, include_role_grants)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="authz-v4"><mxGeometry x="240" y="160" width="190" height="70" as="geometry"/></mxCell><mxCell id="authz-v8" value="&lt;b&gt;EffectiveGrants&lt;/b&gt;&lt;br&gt;catalog_version · [ position, text? ]" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="authz-v4"><mxGeometry x="470" y="160" width="180" height="70" as="geometry"/></mxCell><mxCell id="authz-v9" value="&lt;b&gt;PermissionCodec.encode&lt;/b&gt;&lt;br&gt;bitset + text map" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="authz-v4"><mxGeometry x="470" y="44" width="180" height="70" as="geometry"/></mxCell><mxCell id="authz-v10" value="&lt;b&gt;Claims.authz&lt;/b&gt;&lt;br&gt;roles · EncodedPermissions" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="authz-v4"><mxGeometry x="680" y="44" width="160" height="70" as="geometry"/></mxCell><mxCell id="authz-v11" value="&lt;b&gt;JWT payload&lt;/b&gt;&lt;br&gt;rol · prm { b, t } · pv" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="authz-v4"><mxGeometry x="680" y="160" width="160" height="70" as="geometry"/></mxCell><mxCell id="authz-v12" value="if catalog_version &amp;gt; cache:&lt;br&gt;&lt;b&gt;load_catalog&lt;/b&gt; → CatalogCache" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#fff2e0;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="authz-v4"><mxGeometry x="14" y="160" width="190" height="70" as="geometry"/></mxCell><mxCell id="authz-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="authz-v5" target="authz-v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authz-e14" value="permission modes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontColor=#9a5b00;" edge="1" parent="1" source="authz-v6" target="authz-v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authz-e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="authz-v7" target="authz-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authz-e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="authz-v8" target="authz-v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authz-e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="authz-v9" target="authz-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authz-e18" value="Ed25519 mint" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="authz-v10" target="authz-v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authz-e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontColor=#9a5b00;" edge="1" parent="1" source="authz-v7" target="authz-v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authz-v20" value="Check — every request (no I/O)" style="swimlane;html=1;rounded=1;arcSize=1;startSize=28;fontStyle=1;fontSize=13;fillColor=#f7f7f7;strokeColor=#999999;swimlaneFillColor=#fbfbfb;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="400" y="400" width="860" height="190" as="geometry"/></mxCell><mxCell id="authz-v21" value="&lt;b&gt;Claims&lt;/b&gt;&lt;br&gt;from TokenVerifier.verify" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;" vertex="1" parent="authz-v20"><mxGeometry x="14" y="44" width="170" height="64" as="geometry"/></mxCell><mxCell id="authz-v22" value="&lt;b&gt;AuthorizerImpl&lt;/b&gt;&lt;br&gt;has_role · roles · permissions" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;" vertex="1" parent="authz-v20"><mxGeometry x="214" y="44" width="190" height="64" as="geometry"/></mxCell><mxCell id="authz-v23" value="&lt;b&gt;PermissionCodec.decode&lt;/b&gt;&lt;br&gt;(encoded, CatalogCache)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="authz-v20"><mxGeometry x="434" y="44" width="190" height="64" as="geometry"/></mxCell><mxCell id="authz-v24" value="&lt;b&gt;EffectivePermissions&lt;/b&gt;&lt;br&gt;allowed · choice · choices · text&lt;br&gt;catalog_outdated" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;" vertex="1" parent="authz-v20"><mxGeometry x="654" y="44" width="190" height="74" as="geometry"/></mxCell><mxCell id="authz-v25" value="&lt;b&gt;CatalogCache&lt;/b&gt; — startup reload · catalog writes · newer version at login / refresh" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;" vertex="1" parent="authz-v20"><mxGeometry x="214" y="128" width="410" height="44" as="geometry"/></mxCell><mxCell id="authz-e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#4d9900;fontColor=#336600;" edge="1" parent="1" source="authz-v21" target="authz-v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authz-e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#4d9900;fontColor=#336600;" edge="1" parent="1" source="authz-v22" target="authz-v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authz-e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#4d9900;fontColor=#336600;" edge="1" parent="1" source="authz-v23" target="authz-v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authz-e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#4d9900;fontColor=#336600;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="authz-v25" target="authz-v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authz-v30" value="Catalog distribution — separate request, cached" style="swimlane;html=1;rounded=1;arcSize=1;startSize=28;fontStyle=1;fontSize=13;fillColor=#f7f7f7;strokeColor=#999999;swimlaneFillColor=#fbfbfb;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1290" y="100" width="430" height="520" as="geometry"/></mxCell><mxCell id="authz-v31" value="&lt;b&gt;PermissionService&lt;/b&gt;&lt;br&gt;define · add_option · delete&lt;br&gt;&lt;font color=#555&gt;store write · reload cache · push catalog_changed&lt;/font&gt;" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#fff2e0;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="authz-v30"><mxGeometry x="20" y="44" width="390" height="70" as="geometry"/></mxCell><mxCell id="authz-v32" value="&lt;b&gt;CatalogCache&lt;/b&gt; (backend memory)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;" vertex="1" parent="authz-v30"><mxGeometry x="20" y="140" width="390" height="44" as="geometry"/></mxCell><mxCell id="authz-v33" value="&lt;b&gt;GET /permissions/catalog&lt;/b&gt;&lt;br&gt;api::handlers::permission_catalog → PermissionCatalogResponse" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="authz-v30"><mxGeometry x="20" y="210" width="390" height="60" as="geometry"/></mxCell><mxCell id="authz-v34" value="&lt;b&gt;SPA catalogFor(pv)&lt;/b&gt;&lt;br&gt;localStorage cache keyed by version&lt;br&gt;download only if missing or pv &amp;gt; version" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="authz-v30"><mxGeometry x="20" y="296" width="390" height="70" as="geometry"/></mxCell><mxCell id="authz-v35" value="&lt;b&gt;decodeAuthz(token, catalog)&lt;/b&gt;&lt;br&gt;roles from rol · permissions from prm — UI rendering" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="authz-v30"><mxGeometry x="20" y="392" width="390" height="60" as="geometry"/></mxCell><mxCell id="authz-e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="authz-v31" target="authz-v32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authz-e37" value="served from memory" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#4d9900;fontColor=#336600;" edge="1" parent="1" source="authz-v32" target="authz-v33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authz-e38" value="once per version" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="authz-v33" target="authz-v34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authz-e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="authz-v34" target="authz-v35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authz-v40" value="&lt;b&gt;Encoding v1&lt;/b&gt; (docs/authorization.md)&lt;br&gt;• permanent &lt;b&gt;positions&lt;/b&gt; from one sequence: bool / text permissions and every option; never reused&lt;br&gt;• &lt;b&gt;b&lt;/b&gt;: bit p = byte p/8, bit p%8 (LSB first), trailing zeros trimmed, base64url without padding&lt;br&gt;• &lt;b&gt;t&lt;/b&gt;: { position: text }&lt;br&gt;• &lt;b&gt;pv&lt;/b&gt; = catalog version = highest position in use&lt;br&gt;• unknown positions ignored → fail closed" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfae5a;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="560" height="140" as="geometry"/></mxCell><mxCell id="authz-v41" value="&lt;b&gt;Combined merge&lt;/b&gt; (direct grants + active roles)&lt;br&gt;• bool: any source&lt;br&gt;• multi: union of options&lt;br&gt;• single / text: direct grant wins, else role with the lowest code&lt;br&gt;&lt;br&gt;&lt;b&gt;Admin changes&lt;/b&gt;: grant_to_user · grant_to_role · RoleService.assign / revoke → store write, effective at the user's &lt;b&gt;next refresh&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfae5a;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="660" width="560" height="140" as="geometry"/></mxCell><mxCell id="authz-v42" value="&lt;b&gt;Across instances&lt;/b&gt; (see page 8)&lt;br&gt;catalog writes push &lt;i&gt;catalog_changed { version }&lt;/i&gt;; instances with an older cache reload it once. Grants reach tokens at the next refresh; to cut a user off immediately, revoke their sessions (pushed at once)." style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;" vertex="1" parent="1"><mxGeometry x="1200" y="660" width="520" height="120" as="geometry"/></mxCell><mxCell id="authz-v43" value="&lt;b&gt;Example&lt;/b&gt;&lt;br&gt;rol: [&quot;user&quot;] · prm: { b: &quot;Bg&quot;, t: { &quot;6&quot;: &quot;250&quot; } } · pv: 6&lt;br&gt;→ reports.view (bit 1), reports.export = csv (bit 2), upload.max_mb = 250" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfae5a;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="560" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="revocation" name="5 · Sessions &amp; revocation"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="revocation-v1" value="Sessions, rotation and revocation" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1680" height="36" as="geometry"/></mxCell><mxCell id="revocation-v2" value="One session per login and device; refresh tokens rotate per generation with reuse detection. Revoking ends the whole session, stores a pending revocation, blocks it locally and pushes it to every instance; the first use of a covered token enforces it." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1680" height="36" as="geometry"/></mxCell><mxCell id="revocation-v3" value="Session lifecycle (sessions.status)" style="swimlane;html=1;rounded=1;arcSize=1;startSize=28;fontStyle=1;fontSize=13;fillColor=#f7f7f7;strokeColor=#999999;swimlaneFillColor=#fbfbfb;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="560" height="420" as="geometry"/></mxCell><mxCell id="revocation-v4" value="active" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="revocation-v3"><mxGeometry x="210" y="60" width="140" height="60" as="geometry"/></mxCell><mxCell id="revocation-v5" value="revoked" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="revocation-v3"><mxGeometry x="40" y="260" width="140" height="60" as="geometry"/></mxCell><mxCell id="revocation-v6" value="compromised" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="revocation-v3"><mxGeometry x="380" y="260" width="140" height="60" as="geometry"/></mxCell><mxCell id="revocation-e7" value="revoked token used" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="revocation-v5" target="revocation-v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="revocation-v8" value="purged&lt;br&gt;&lt;font style='font-size:10px'&gt;(row deleted)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="revocation-v3"><mxGeometry x="210" y="340" width="140" height="56" as="geometry"/></mxCell><mxCell id="revocation-e9" value="logout · logout_all · evicted&lt;br&gt;administrative · password_changed&lt;br&gt;account_disabled · account_deleted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="revocation-v4" target="revocation-v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="revocation-e10" value="token_reuse · ip_mismatch&lt;br&gt;compromised · revoked_token_used" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="revocation-v4" target="revocation-v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="revocation-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="revocation-v5" target="revocation-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="revocation-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="revocation-v6" target="revocation-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="revocation-e13" value="idle / absolute expiry&lt;br&gt;+ retention" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="revocation-v4" target="revocation-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="revocation-v14" value="Refresh-token generations (session_generations)" style="swimlane;html=1;rounded=1;arcSize=1;startSize=28;fontStyle=1;fontSize=13;fillColor=#f7f7f7;strokeColor=#999999;swimlaneFillColor=#fbfbfb;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="560" height="260" as="geometry"/></mxCell><mxCell id="revocation-v15" value="&lt;b&gt;gen N&lt;/b&gt; — current&lt;br&gt;rotate → N+1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="revocation-v14"><mxGeometry x="20" y="44" width="160" height="60" as="geometry"/></mxCell><mxCell id="revocation-v16" value="&lt;b&gt;gen N−1&lt;/b&gt;&lt;br&gt;superseded_at set&lt;br&gt;grace 30 s, same IP → current pair" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;" vertex="1" parent="revocation-v14"><mxGeometry x="200" y="44" width="170" height="70" as="geometry"/></mxCell><mxCell id="revocation-v17" value="&lt;b&gt;older gens&lt;/b&gt; (history 10)&lt;br&gt;presented again → &lt;b&gt;token_reuse&lt;/b&gt; → compromised" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontColor=#b85450;spacing=8;" vertex="1" parent="revocation-v14"><mxGeometry x="390" y="44" width="150" height="80" as="geometry"/></mxCell><mxCell id="revocation-v18" value="&lt;b&gt;Refresh policy&lt;/b&gt; (evaluate_refresh)&lt;br&gt;not active → TokenRevoked · past idle / absolute → SessionExpired · bad MAC / unknown gen → InvalidToken · jti mismatch → reuse · IP binding mismatch → IpMismatch · current → Rotate · previous within grace → ReturnCurrent · otherwise → TokenReuse" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfae5a;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=11;" vertex="1" parent="revocation-v14"><mxGeometry x="20" y="140" width="520" height="100" as="geometry"/></mxCell><mxCell id="revocation-v19" value="Revocation flow — pending → pushed → enforced on first use" style="swimlane;html=1;rounded=1;arcSize=1;startSize=28;fontStyle=1;fontSize=13;fillColor=#f7f7f7;strokeColor=#999999;swimlaneFillColor=#fbfbfb;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="1080" height="680" as="geometry"/></mxCell><mxCell id="revocation-v20" value="&lt;b&gt;Triggers&lt;/b&gt;&lt;br&gt;logout · logout_all · session cap eviction · refresh-policy compromise (token reuse, IP mismatch)&lt;br&gt;UserService: password change · deactivate · delete · admin / API revoke (tokens · sessions · users)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="revocation-v19"><mxGeometry x="20" y="44" width="1040" height="60" as="geometry"/></mxCell><mxCell id="revocation-v21" value="&lt;b&gt;TokenRevocationServiceImpl&lt;/b&gt;&lt;br&gt;end_session · end_all_for_user · revoke_many" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="revocation-v19"><mxGeometry x="380" y="130" width="320" height="60" as="geometry"/></mxCell><mxCell id="revocation-v22" value="&lt;b&gt;1 SessionRepository.end&lt;/b&gt;&lt;br&gt;&lt;font color=#555&gt;session revoked now → refresh fails everywhere&lt;/font&gt;" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#fff2e0;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="revocation-v19"><mxGeometry x="20" y="230" width="300" height="70" as="geometry"/></mxCell><mxCell id="revocation-v23" value="&lt;b&gt;2 RevocationRepository.insert&lt;/b&gt;&lt;br&gt;status &lt;b&gt;pending&lt;/b&gt; · origin_node · revoked_at / expires_at from now()" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#fff2e0;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="revocation-v19"><mxGeometry x="360" y="230" width="340" height="70" as="geometry"/></mxCell><mxCell id="revocation-v24" value="&lt;b&gt;3 Denylist.apply&lt;/b&gt; — this instance, immediately" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;" vertex="1" parent="revocation-v19"><mxGeometry x="740" y="230" width="320" height="70" as="geometry"/></mxCell><mxCell id="revocation-v25" value="&lt;b&gt;revocations&lt;/b&gt; table&lt;br&gt;pending → enforced" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="revocation-v19"><mxGeometry x="380" y="340" width="300" height="80" as="geometry"/></mxCell><mxCell id="revocation-v26" value="&lt;b&gt;4 push&lt;/b&gt; &lt;i&gt;revoked&lt;/i&gt; to every instance&lt;br&gt;EventPublisher → ClusterPublisher" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="revocation-v19"><mxGeometry x="740" y="340" width="320" height="70" as="geometry"/></mxCell><mxCell id="revocation-v27" value="&lt;b&gt;Other instances&lt;/b&gt;: receive → Denylist.apply&lt;br&gt;&lt;font color=#555&gt;blocked there at once, memory only&lt;/font&gt;" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;" vertex="1" parent="revocation-v19"><mxGeometry x="740" y="450" width="320" height="70" as="geometry"/></mxCell><mxCell id="revocation-v28" value="&lt;b&gt;Startup&lt;/b&gt;: AuthLib::start → list_active()&lt;br&gt;→ Denylist (restarting instances)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#fff2e0;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="revocation-v19"><mxGeometry x="20" y="340" width="300" height="70" as="geometry"/></mxCell><mxCell id="revocation-v29" value="&lt;b&gt;Repair&lt;/b&gt;: heartbeat digest ≠ → snapshot request&lt;br&gt;(missed pushes, no database)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;" vertex="1" parent="revocation-v19"><mxGeometry x="20" y="450" width="300" height="70" as="geometry"/></mxCell><mxCell id="revocation-v30" value="&lt;b&gt;5 token presented anywhere&lt;/b&gt;&lt;br&gt;TokenVerifier.verify → 401 token_revoked&lt;br&gt;+ EnforcementHit (once per revocation)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ebfadc;strokeColor=#4d9900;" vertex="1" parent="revocation-v19"><mxGeometry x="740" y="560" width="320" height="80" as="geometry"/></mxCell><mxCell id="revocation-v31" value="&lt;b&gt;6 next tick → enforce_pending&lt;/b&gt;&lt;br&gt;mark_enforced (CAS — one instance wins) → session &lt;b&gt;compromised&lt;/b&gt; (revoked_token_used) → push &lt;i&gt;revocation_enforced&lt;/i&gt;" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#fff2e0;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="revocation-v19"><mxGeometry x="20" y="560" width="680" height="80" as="geometry"/></mxCell><mxCell id="revocation-e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="revocation-v20" target="revocation-v21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="revocation-e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontColor=#9a5b00;" edge="1" parent="1" source="revocation-v21" target="revocation-v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="revocation-e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontColor=#9a5b00;" edge="1" parent="1" source="revocation-v21" target="revocation-v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="revocation-e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#4d9900;fontColor=#336600;" edge="1" parent="1" source="revocation-v21" target="revocation-v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="revocation-e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontColor=#9a5b00;" edge="1" parent="1" source="revocation-v23" target="revocation-v25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="revocation-e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontColor=#6a4c80;" edge="1" parent="1" source="revocation-v24" target="revocation-v26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="revocation-e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontColor=#6a4c80;" edge="1" parent="1" source="revocation-v26" target="revocation-v27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="revocation-e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#4d9900;fontColor=#336600;" edge="1" parent="1" source="revocation-v27" target="revocation-v30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="revocation-e40" value="hit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#4d9900;fontColor=#336600;" edge="1" parent="1" source="revocation-v30" target="revocation-v31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="revocation-e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontColor=#9a5b00;exitX=0.55;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="revocation-v31" target="revocation-v25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="revocation-v42" value="&lt;b&gt;Housekeeping&lt;/b&gt; (host-scheduled): purge_sessions(retention) · purge_expired()" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfae5a;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="560" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="schema" name="6 · Database schema"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="schema-v1" value="PostgreSQL schema — migrations 0001–0004 (auth-lib-postgres)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1680" height="36" as="geometry"/></mxCell><mxCell id="schema-v2" value="uuid primary keys, created_at on every table, database-assigned time (now(), timestamptz, UTC), ENUM types for closed sets. Solid lines: foreign keys (ON DELETE CASCADE). Dashed: logical references." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1680" height="36" as="geometry"/></mxCell><mxCell id="schema-v3" value="&lt;b&gt;users&lt;/b&gt;&lt;hr size=1&gt;id uuid PK&lt;br&gt;email varchar(255) — UK lower(email)&lt;br&gt;password_hash text&lt;br&gt;username varchar(100) — UK lower()&lt;br&gt;first_name · last_name varchar(255)&lt;br&gt;avatar_url text&lt;br&gt;is_active bool&lt;br&gt;is_verified bool&lt;br&gt;created_at · updated_at timestamptz" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="270" height="169" as="geometry"/></mxCell><mxCell id="schema-v4" value="&lt;b&gt;roles&lt;/b&gt;&lt;hr size=1&gt;id uuid PK&lt;br&gt;code varchar(64) UK — in tokens (rol)&lt;br&gt;name varchar(50) UK&lt;br&gt;description text&lt;br&gt;created_at timestamptz" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="270" height="109" as="geometry"/></mxCell><mxCell id="schema-v5" value="&lt;b&gt;users_roles&lt;/b&gt;&lt;hr size=1&gt;id uuid PK&lt;br&gt;user_id FK → users&lt;br&gt;role_id FK → roles&lt;br&gt;assigned_at timestamptz&lt;br&gt;revoked_at timestamptz (NULL = active)&lt;br&gt;created_at timestamptz&lt;br&gt;UK (user_id, role_id) WHERE active" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="300" height="139" as="geometry"/></mxCell><mxCell id="schema-v6" value="&lt;b&gt;sessions&lt;/b&gt;&lt;hr size=1&gt;id uuid PK&lt;br&gt;user_id FK → users&lt;br&gt;secret bytea&lt;br&gt;status session_status&lt;br&gt;end_reason revocation_reason&lt;br&gt;created_ip inet&lt;br&gt;user_agent varchar(512)&lt;br&gt;current_generation int&lt;br&gt;created_at timestamptz&lt;br&gt;idle_expires_at · absolute_expires_at&lt;br&gt;ended_at timestamptz&lt;br&gt;CHECK active ⇔ ended_at / end_reason NULL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="300" height="214" as="geometry"/></mxCell><mxCell id="schema-v7" value="&lt;b&gt;session_generations&lt;/b&gt;&lt;hr size=1&gt;id uuid PK (= access-token jti)&lt;br&gt;session_id FK → sessions&lt;br&gt;generation int&lt;br&gt;issued_ip inet&lt;br&gt;issued_at · access_expires_at&lt;br&gt;superseded_at timestamptz&lt;br&gt;created_at timestamptz&lt;br&gt;UK (session_id, generation)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="300" height="154" as="geometry"/></mxCell><mxCell id="schema-v8" value="&lt;b&gt;revocations&lt;/b&gt;&lt;hr size=1&gt;id uuid PK&lt;br&gt;scope revocation_scope&lt;br&gt;subject uuid — session / user id (no FK)&lt;br&gt;reason revocation_reason&lt;br&gt;status revocation_status (pending / enforced)&lt;br&gt;origin_node uuid&lt;br&gt;revoked_at · expires_at timestamptz&lt;br&gt;enforced_at timestamptz · enforced_by uuid&lt;br&gt;created_at timestamptz&lt;br&gt;CHECK enforced ⇔ enforced_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="420" width="300" height="184" as="geometry"/></mxCell><mxCell id="schema-v9" value="&lt;b&gt;cluster_nodes — state machine&lt;/b&gt;&lt;hr size=1&gt;id uuid PK (= node id)&lt;br&gt;service varchar(100)&lt;br&gt;ip inet · dns_name varchar(253)&lt;br&gt;port int (1–65535)&lt;br&gt;version varchar(32)&lt;br&gt;state node_state (joining → active → leaving)&lt;br&gt;heartbeat heartbeat_status (online / offline)&lt;br&gt;state_changed_at · heartbeat_changed_at&lt;br&gt;started_at · created_at&lt;br&gt;written only on state changes" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="720" y="420" width="300" height="184" as="geometry"/></mxCell><mxCell id="schema-v10" value="&lt;b&gt;verifying_keys&lt;/b&gt;&lt;hr size=1&gt;id uuid PK&lt;br&gt;kid varchar(32) UK — JWT key id&lt;br&gt;public_key bytea (32, public only)&lt;br&gt;status verifying_key_status&lt;br&gt;published_by uuid&lt;br&gt;revoked_at timestamptz&lt;br&gt;created_at timestamptz" style="rounded=0;whiteSpace=wrap;html=1;align=le