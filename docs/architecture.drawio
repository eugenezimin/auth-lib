<mxfile host="Electron" agent="auth-lib docs generator" version="24.0.0"><diagram id="overview" name="1 · Overview"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="overview-v1" value="auth-lib — high-level architecture" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1640" height="36" as="geometry"/></mxCell><mxCell id="overview-v2" value="Storage- and transport-agnostic auth library. The host wires it to its web framework, an adapter and a cluster transport; instances push changes to each other, so token verification never touches the database." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1640" height="36" as="geometry"/></mxCell><mxCell id="overview-v3" value="Clients &amp; peers" style="swimlane;html=1;rounded=1;arcSize=1;startSize=28;fontStyle=1;fontSize=13;fillColor=#f7f7f7;strokeColor=#999999;swimlaneFillColor=#fbfbfb;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="270" height="560" as="geometry"/></mxCell><mxCell id="overview-v4" value="&lt;b&gt;Browser — React SPA&lt;/b&gt;&lt;br&gt;auth-lib-harness/frontend&lt;br&gt;&lt;font color=#555&gt;token pair in session/localStorage · decodes &lt;i&gt;rol&lt;/i&gt; / &lt;i&gt;prm&lt;/i&gt; with the cached catalog&lt;/font&gt;" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="overview-v3"><mxGeometry x="20" y="44" width="230" height="110" as="geometry"/></mxCell><mxCell id="overview-v5" value="&lt;b&gt;Other auth-lib instances&lt;/b&gt;&lt;br&gt;other services / replicas&lt;br&gt;&lt;font color=#555&gt;each keeps the replicated state 