uthn-v2" value="Orange steps read or write the store; green steps are pure memory. Timestamps and ids are assigned by the database (now(), gen_random_uuid()); the core passes durations only." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1640" height="36" as="geometry"/></mxCell><mxCell id="authn-v3" value="Login — POST /login" style="swimlane;html=1;rounded=1;arcSize=1;startSize=28;fontStyle=1;fontSize=13;fillColor=#f7f7f7;strokeColor=#999999;swimlaneFillColor=#fbfbfb;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="520" height="636" as="geometry"/></mxCell><mxCell id="authn-v4" value="&lt;b&gt;1&lt;/b&gt; LoginRequest { email, password } + ClientContext { ip, user_agent }" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="authn-v3"><mxGeometry x="14" y="40" width="492" height="44" as="geometry"/></mxCell><mxCell id="authn-v5" value="&lt;b&gt;2&lt;/b&gt; normalize_email (trim + lowercase)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="authn-v3"><mxGeometry x="14" y="106" width="492" height="34" as="geometry"/></mxCell><mxCell id="authn-v6" value="&lt;b&gt;3&lt;/b&gt; UserRepository.&lt;b&gt;find_with_roles_by_email&lt;/b&gt; — account + active roles (one join)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#fff2e0;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="authn-v3"><mxGeometry x="14" y="162" width="492" height="48" as="geometry"/></mxCell><mxCell id="authn-v7" value="&lt;b&gt;4&lt;/b&gt; PasswordHasher.verify (Argon2id) · is_active" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontS